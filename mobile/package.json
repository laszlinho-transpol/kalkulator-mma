{
  "name": "mobile",
  "version": "1.5.8",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "babel-preset-expo": "^56.0.15",
    "expo": "~56.0.12",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-document-picker": "^56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-linking": "~56.0.14",
    "expo-mail-composer": "~56.0.4",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.11",
    "expo-sharing": "~56.0.18",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:telefon": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "tsx --test src/**/*.test.ts",
    "verify": "node scripts/verify-release.mjs",
    "fix:gradle": "node scripts/fix-gradle-foojay.mjs",
    "setup:android": "node scripts/setup-android-local.mjs",
    "postinstall": "node scripts/fix-gradle-foojay.mjs",
    "prebuild:android": "node scripts/fix-gradle-foojay.mjs && npx expo prebuild --platform android",
    "build:android:local": "node scripts/fix-gradle-foojay.mjs && node scripts/setup-android-local.mjs && cd android && gradlew.bat assembleRelease",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview --non-interactive",
    "release:play": "npx eas-cli@latest build --platform android --profile production --auto-submit --non-interactive"
  },
  "private": true
}
