{
  "expo": {
    "name": "Kalkulator MMA",
    "slug": "kalkulator-mma",
    "version": "1.5.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "kalkulator-mma",
    "owner": "laszlinho",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kalkulatormma.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Kalkulator MMA nie używa kamery.",
        "NSPhotoLibraryUsageDescription": "Dostęp do biblioteki zdjęć nie jest wymagany.",
        "NSLocationWhenInUseUsageDescription": "Kalkulator MMA nie używa lokalizacji."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#0F0F1A",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kalkulatormma.app",
      "versionCode": 11,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-mail-composer",
      "@react-native-community/datetimepicker",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "59296c50-c7c9-45ad-b276-a0088ceac626"
      },
      "router": {}
    }
  }
}
